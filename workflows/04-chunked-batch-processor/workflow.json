{
  "name": "Chunked Batch Processor",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chunked-batch-processor",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "04-webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -900,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\nconst batchSize = Number(body.batch_size ?? 3);\nif (!Array.isArray(body.items) || body.items.length === 0 ||\n    body.items.some(item => !item || typeof item !== 'object' || Array.isArray(item)) ||\n    !Number.isInteger(batchSize) || batchSize < 1 || batchSize > 1000) {\n  return [{json: {ok: false, error: 'items must be a non-empty array of objects; batch_size must be an integer from 1 to 1000', statusCode: 400}}];\n}\nreturn [{json: {ok: true, items: body.items, batch_size: batchSize}}];"
      },
      "id": "04-load-input-array",
      "name": "Load Input Array",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -640,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json;\nreturn body.items.map((item, index) => ({json: {item, item_index: index, batch_size: body.batch_size}, pairedItem: {item: 0}}));"
      },
      "id": "04-validate-array",
      "name": "Validate Array",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        0
      ]
    },
    {
      "parameters": {
        "batchSize": "={{$json.batch_size || 10}}",
        "options": {
          "reset": false
        }
      },
      "id": "04-split-in-batches",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -160,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Synthetic per-item work only. Replace with your actual processing boundary.\nreturn $input.all().map((entry, index) => {\n  const data = entry.json;\n  try {\n    if (data.item.simulate_failure === true) throw new Error('Synthetic item failure');\n    return {json: {...data, id: data.item.id ?? data.item_index, status: 'processed', processed_at: new Date().toISOString()}, pairedItem: {item: index}};\n  } catch (error) {\n    return {json: {...data, id: data.item.id ?? data.item_index, status: 'failed', error: String(error.message), processed_at: new Date().toISOString()}, pairedItem: {item: index}};\n  }\n});"
      },
      "id": "04-process-item-placeholder",
      "name": "Process Item Placeholder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        -80
      ]
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "seconds"
      },
      "id": "04-delay-rate-limit",
      "name": "Delay / Rate Limit",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        320,
        -80
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const results = $input.all().map(entry => entry.json);\nconst failed = results.filter(item => item.status === 'failed');\nconst processed = results.filter(item => item.status === 'processed');\nreturn [{json: {ok: failed.length === 0, processed_count: processed.length, failed_count: failed.length, batch_size: results[0]?.batch_size ?? 3, results}}];"
      },
      "id": "04-collect-results",
      "name": "Collect Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        -80
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const summary = $input.first().json;\nreturn [{json: {...summary, failed_items: summary.results.filter(item => item.status === 'failed')}}];"
      },
      "id": "04-handle-failed-items",
      "name": "Handle Failed Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        -80
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}",
        "options": {
          "responseCode": "={{$json.statusCode || 200}}"
        }
      },
      "id": "04-return-summary",
      "name": "Return Summary",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
